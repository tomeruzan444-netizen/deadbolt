---
/**
 * Custom duotone service icons, drawn for Deadbolt Fixers on a 48x48 grid.
 * Strokes use currentColor; `.a` shapes take the brass accent fill from the parent.
 */
interface Props { name: string; size?: number }
const { name, size = 40 } = Astro.props;
---
<svg class="si" width={size} height={size} viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'lockout' && (<>
    <path d="M8 6h20v36H8z" />
    <path d="M34 4v40" />
    <circle class="a" cx="21" cy="21" r="4.5" />
    <rect class="a" x="25.5" y="19.25" width="8.5" height="3.5" rx="1" />
    <circle cx="40" cy="29" r="3" />
    <path d="M40 32v10M40 37h2.5M40 40.5h2" />
    <path d="M21 31v3" />
  </>)}
  {name === 'install' && (<>
    <path d="M7 6h22v36H7z" />
    <circle class="a" cx="20" cy="22" r="6" stroke-dasharray="3 2.4" />
    <path d="M26 22h3" stroke-dasharray="2 2" />
    <circle cx="20" cy="22" r="1.4" />
    <circle class="a" cx="38" cy="11" r="6.5" />
    <path d="M38 8v6M35 11h6" />
    <path d="M14 34h12" stroke-dasharray="1.5 2.5" />
  </>)}
  {name === 'repair' && (<>
    <circle class="a" cx="16" cy="16" r="9" />
    <circle cx="16" cy="16" r="3" />
    <path d="M16 13v6" />
    <path d="M37.5 15.5a6 6 0 0 0-7.6 7.6L19 34a2.6 2.6 0 0 0 3.7 3.7l10.9-10.9a6 6 0 0 0 7.6-7.6l-3.6 3.6-3.4-.6-.6-3.4z" />
  </>)}
  {name === 'rekey' && (<>
    <rect class="a" x="5" y="22" width="30" height="11" rx="2.5" />
    <path d="M11 22v-9M17 22v-6M23 22v-10M29 22v-7" />
    <circle cx="11" cy="11.5" r="1.5" /><circle cx="17" cy="14.5" r="1.5" /><circle cx="23" cy="10.5" r="1.5" /><circle cx="29" cy="13.5" r="1.5" />
    <path d="M35 27.5h8" />
    <path d="M9 37l3 3 3-3 3 3 3-3 3 3 3-3" />
  </>)}
  {name === 'replace' && (<>
    <circle cx="13" cy="24" r="7.5" stroke-dasharray="3 2.6" />
    <circle class="a" cx="35" cy="24" r="7.5" />
    <circle cx="35" cy="24" r="2.2" />
    <path d="M14 12.5c4-5 16-5 20 0" />
    <path d="M30.5 9.5l3.5 3-4 2" />
    <path d="M34 35.5c-4 5-16 5-20 0" />
    <path d="M17.5 38.5l-3.5-3 4-2" />
  </>)}
  {name === 'smart' && (<>
    <rect class="a" x="12" y="6" width="20" height="36" rx="4" />
    <circle cx="18" cy="15" r="1" /><circle cx="22" cy="15" r="1" /><circle cx="26" cy="15" r="1" />
    <circle cx="18" cy="20" r="1" /><circle cx="22" cy="20" r="1" /><circle cx="26" cy="20" r="1" />
    <circle cx="18" cy="25" r="1" /><circle cx="22" cy="25" r="1" /><circle cx="26" cy="25" r="1" />
    <circle cx="22" cy="34" r="3" />
    <path d="M37 13a6 6 0 0 1 0 8M40.5 10a11 11 0 0 1 0 14" />
  </>)}
  {name === 'brokenkey' && (<>
    <circle class="a" cx="11" cy="24" r="6.5" />
    <circle cx="11" cy="24" r="2" />
    <path d="M17.5 24h7l-1.6 2.4 1.6 2.6" />
    <path d="M29 21l-1.6 2.6 1.6 2.4h12" />
    <path d="M33 26v4M37 26v3M41 26v4" />
    <path d="M26 15l1 3M31 14l-1 3.5" />
  </>)}
  {name === 'shield' && (<>
    <path class="a" d="M24 5l15 5.5v11c0 9.5-6.4 17.4-15 21-8.6-3.6-15-11.5-15-21v-11z" />
    <circle cx="24" cy="21" r="3.5" />
    <path d="M24 24.5v7" />
    <path d="M17 9.5" />
  </>)}
  {name === 'double' && (<>
    <rect x="6" y="20" width="36" height="8" rx="1" />
    <rect class="a" x="17" y="12" width="8" height="8" rx="1.5" />
    <rect class="a" x="17" y="28" width="8" height="8" rx="1.5" />
    <path d="M21 14.5v3.5M21 30.5v3.5" />
    <path d="M42 24h3" />
    <path d="M31 8l4 4M35 8l-4 4" opacity=".55" />
    <path d="M8 40h12M28 40h12" stroke-dasharray="1.5 2.5" />
  </>)}
  {name === 'keyedalike' && (<>
    <circle class="a" cx="10" cy="12" r="4.5" /><path d="M14.5 12h26l-2 3h-3v-3M30 12v3" />
    <circle class="a" cx="10" cy="24" r="4.5" /><path d="M14.5 24h26l-2 3h-3v-3M30 24v3" />
    <circle class="a" cx="10" cy="36" r="4.5" /><path d="M14.5 36h26l-2 3h-3v-3M30 36v3" />
  </>)}
  {name === 'strike' && (<>
    <rect x="30" y="4" width="13" height="40" stroke-dasharray="2.5 2.5" />
    <rect class="a" x="16" y="8" width="9" height="32" rx="1.5" />
    <rect x="18" y="19" width="5" height="10" rx="1" />
    <path d="M20.5 12.5H41M20.5 35.5H41" />
    <path d="M38 11v3M38 34v3" />
    <path d="M5 24h11" />
    <path d="M9 20.5l-4 3.5 4 3.5" />
  </>)}
  {name === 'commercial' && (<>
    <path d="M6 16h36v26H6z" />
    <path class="a" d="M5 16l3-8h32l3 8c0 2.5-2.7 4-5.4 4s-4.8-1.5-4.8-4c0 2.5-2.4 4-5.4 4s-4.8-1.5-4.8-4c0 2.5-2.4 4-5.4 4S10 18.5 10 16c0 2.5-2.3 4-5 4z" />
    <path d="M20 42V28h10v14" />
    <circle cx="27" cy="34" r="1" />
    <path d="M10 26h6v6h-6zM34 26h4v6h-4z" />
  </>)}
  {name === 'help' && (<>
    <circle class="a" cx="24" cy="24" r="17" />
    <path d="M19 19.5a5 5 0 1 1 6.6 4.7c-1 .4-1.6 1.3-1.6 2.3v1.5" />
    <circle cx="24" cy="33" r="1" />
  </>)}
</svg>

<style>
  .si { display: block; flex: none; }
  .si .a { fill: var(--si-accent, rgba(201, 160, 78, 0.32)); }
</style>
