---
/** Small stroke icon set in the house line style. Decorative by default. */
interface Props { name: string; size?: number; class?: string; label?: string }
const { name, size = 20, class: cls, label } = Astro.props;

const paths: Record<string, string> = {
  phone: '<path d="M5 3.5h3.2l1.6 4-2 1.3a11 11 0 0 0 5.4 5.4l1.3-2 4 1.6V17a2 2 0 0 1-2.2 2A15.5 15.5 0 0 1 3 5.7 2 2 0 0 1 5 3.5Z"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="1.5"/><path d="m3.5 6 8.5 7 8.5-7"/>',
  pin: '<path d="M12 21s-6.5-6.1-6.5-11a6.5 6.5 0 0 1 13 0c0 4.9-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.3"/>',
  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  arrow: '<path d="M4 12h15M13 6l6 6-6 6"/>',
  chevron: '<path d="m6 9 6 6 6-6"/>',
  menu: '<path d="M3.5 7h17M3.5 12h17M3.5 17h17"/>',
  close: '<path d="m5.5 5.5 13 13M18.5 5.5l-13 13"/>',
  check: '<path d="m4.5 12.5 4.5 4.5L19.5 7"/>',
  alert: '<path d="M12 3.5 2.8 19.5h18.4L12 3.5Z"/><path d="M12 10v4.5M12 17.2v.3"/>',
  // service icons
  install: '<rect x="4" y="3" width="10" height="18" rx="1"/><circle cx="11" cy="12" r="2.2"/><path d="M14 12h6M18 10v4"/>',
  repair: '<path d="M14.5 6.5a4 4 0 0 0-5.3 5L3.8 17a1.6 1.6 0 0 0 2.2 2.2l5.5-5.4a4 4 0 0 0 5-5.3l-2.4 2.4-2-.5-.5-2 2.4-2.4Z"/>',
  lockout: '<rect x="5" y="10.5" width="14" height="10" rx="1.5"/><path d="M8 10.5V7.5a4 4 0 0 1 7.6-1.8"/><circle cx="12" cy="15.5" r="1.4"/>',
  rekey: '<circle cx="7.5" cy="12" r="3.5"/><path d="M11 12h10M17 12v3M20 12v2.5"/>',
  replace: '<path d="M4 9a8 8 0 0 1 14-3l2 2M20 15a8 8 0 0 1-14 3l-2-2"/><path d="M20 4v4h-4M4 20v-4h4"/>',
  smart: '<rect x="6" y="2.5" width="12" height="19" rx="2"/><path d="M9.5 7h1M13.5 7h1M9.5 10.5h1M13.5 10.5h1M9.5 14h1M13.5 14h1"/><circle cx="12" cy="18" r="1"/>',
  double: '<circle cx="7" cy="12" r="3.5"/><circle cx="17" cy="12" r="3.5"/><path d="M7 10.5v3M17 10.5v3M10.5 12h3"/>',
  shield: '<path d="M12 2.8 4.5 5.6v6c0 4.6 3.2 8.2 7.5 9.6 4.3-1.4 7.5-5 7.5-9.6v-6L12 2.8Z"/><path d="m8.8 12 2.2 2.2 4.4-4.4"/>',
  brokenkey: '<circle cx="6.5" cy="12" r="3"/><path d="M9.5 12h3.5M15.5 12h5M18.5 12v2.5"/><path d="m13.5 9.5 1.5 5"/>',
  keyedalike: '<circle cx="6" cy="8" r="2.6"/><path d="M8.6 8H20M17 8v2.2"/><circle cx="6" cy="16" r="2.6"/><path d="M8.6 16H20M17 16v2.2"/>',
  commercial: '<path d="M3.5 20.5h17M5 20.5V8l7-4.5L19 8v12.5"/><rect x="9.5" y="12" width="5" height="8.5"/><circle cx="13.2" cy="16.2" r=".5"/>',
  strike: '<rect x="8" y="3" width="8" height="18" rx="1"/><rect x="10.3" y="9.5" width="3.4" height="5" rx=".5"/><circle cx="12" cy="5.8" r=".8"/><circle cx="12" cy="18.2" r=".8"/>',
  guide: '<path d="M4 4.5h6a2 2 0 0 1 2 2v13a2 2 0 0 0-2-2H4v-13ZM20 4.5h-6a2 2 0 0 0-2 2v13a2 2 0 0 1 2-2h6v-13Z"/>',
};
const inner = paths[name] ?? paths.arrow;
---
<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={inner}
/>
