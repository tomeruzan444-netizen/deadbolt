---
import type { MarkdownHeading } from 'astro';
interface Props { headings: MarkdownHeading[]; extra?: { slug: string; text: string }[] }
const { headings, extra = [] } = Astro.props;
const items = [...headings.filter((h) => h.depth === 2).map((h) => ({ slug: h.slug, text: h.text })), ...extra];
---
{items.length > 2 && (
  <nav class="toc" aria-labelledby="toc-title">
    <p id="toc-title" class="label">On this page</p>
    <ol>
      {items.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
    </ol>
  </nav>
)}

<style>
  .toc { border: 1px solid var(--line); border-left: 3px solid var(--brass); background: var(--white); border-radius: var(--radius); padding: 16px 20px; margin-block: 28px 8px; max-width: var(--measure); }
  .label { color: var(--brass-ink); margin-bottom: 8px; }
  ol { margin: 0; padding-left: 1.4em; columns: 1; font-size: 0.96rem; line-height: 1.45; }
  @media (min-width: 720px) { ol { columns: 2; column-gap: 32px; } }
  li { break-inside: avoid; padding-block: 3px; }
  li::marker { font-family: var(--font-mono); font-size: 0.8em; color: var(--steel-500); }
  a { color: var(--ink); text-decoration: none; }
  a:hover { color: var(--brass-ink); text-decoration: underline; }
</style>
