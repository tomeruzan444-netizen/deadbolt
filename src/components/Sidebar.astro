---
/** Contextual sidebar driven by src/data/related.ts. Not used on the home page. */
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import ContactDetails from './ContactDetails.astro';
import { related } from '../data/related';
import { serviceUrl, guideUrl } from '../lib/urls';
import { hasPhone, telHref, site } from '../config/site';

interface Props { relatedKey: string }
const { relatedKey } = Astro.props;
const entry = related[relatedKey];
if (!entry) throw new Error(`related.ts has no entry for "${relatedKey}"`);

const services = await getCollection('services');
const guides = await getCollection('guides');
const svc = entry.services.map((slug) => {
  const s = services.find((x) => x.id === slug);
  if (!s) throw new Error(`related.ts: unknown service "${slug}" in "${relatedKey}"`);
  return s;
});
const gds = entry.guides.map((slug) => {
  const g = guides.find((x) => x.id === slug);
  if (!g) throw new Error(`related.ts: unknown guide "${slug}" in "${relatedKey}"`);
  return g;
});
---
<aside class="sidebar" aria-label="Related pages">
  <div class="sticky">
    {svc.length > 0 && (
      <section class="box">
        <h2 class="label">Related services</h2>
        <ul class="links">
          {svc.map((s) => (
            <li>
              <a href={serviceUrl(s.id)}>
                <Icon name={s.data.icon ?? 'install'} size={18} />
                <span>{s.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
    {gds.length > 0 && (
      <section class="box">
        <h2 class="label">Helpful guides</h2>
        <ul class="links">
          {gds.map((g) => (
            <li><a href={guideUrl(g.id)}><Icon name="guide" size={18} /><span>{g.data.title}</span></a></li>
          ))}
        </ul>
      </section>
    )}
    <section class="box dark on-dark">
      <h2 class="label">Need a deadbolt specialist?</h2>
      <p>Describe the lock and the door. We reply with what the job involves before anything is booked.</p>
      <ContactDetails compact />
      <div class="acts">
        {hasPhone() && <a class="btn btn-primary" href={telHref()}><Icon name="phone" /> Call {site.phoneDisplay}</a>}
        <a class:list={['btn', hasPhone() ? 'btn-ghost' : 'btn-primary']} href="/contact/">Request service</a>
      </div>
    </section>
  </div>
</aside>

<style>
  .sidebar { min-width: 0; }
  .sticky { display: grid; gap: 18px; }
  @media (min-width: 1024px) {
    .sticky { position: sticky; top: calc(var(--header-h) + 16px); max-height: calc(100vh - var(--header-h) - 32px); overflow-y: auto; padding-bottom: 4px; scrollbar-width: thin; }
  }
  .box { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 16px 18px; }
  .label { color: var(--brass-ink); margin-bottom: 8px; font-size: 0.74rem; }
  .links { list-style: none; padding: 0; }
  .links li + li { border-top: 1px solid var(--steel-100); }
  .links a { display: flex; gap: 10px; align-items: center; padding: 9px 0; min-height: 44px; color: var(--ink); text-decoration: none; font-family: var(--font-display); font-weight: 600; font-size: 0.94rem; line-height: 1.3; }
  .links a:hover { color: var(--brass-ink); }
  .links a:hover span { text-decoration: underline; }
  .links :global(svg) { color: var(--brass-ink); flex: none; }
  .dark { background: var(--ink); border-color: var(--ink); }
  .dark .label { color: var(--brass); }
  .dark p { font-size: 0.95rem; line-height: 1.55; color: #d6d1c6; margin-bottom: 12px; }
  .acts { display: grid; gap: 8px; margin-top: 14px; }
  .acts .btn { width: 100%; min-height: 46px; font-size: 0.95rem; }
</style>
