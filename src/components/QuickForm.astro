---
/**
 * Short, prominent request form placed directly under the H1 on every page
 * (except /contact/, which has the full form). Same endpoint, validation and
 * lead-source tracking as ContactForm (shared script in FormScript.astro).
 */
import { getCollection } from 'astro:content';
import { site, hasPhone, telHref } from '../config/site';
import Icon from './Icon.astro';
import LeadFields from './LeadFields.astro';

interface Props { heading?: string }
const { heading = 'Get a deadbolt quote' } = Astro.props;
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---
<form class="qform" novalidate data-form data-endpoint={site.formEndpoint} action={site.formEndpoint || undefined} method="post" aria-labelledby="qf-title">
  <div class="qf-head">
    <p class="qf-title" id="qf-title">{heading}</p>
    <p class="qf-sub">Tell Deadbolt Fixers what the lock is doing. We reply with the likely fix and a price before anything is booked.</p>
  </div>
  <LeadFields form="quick-form" />
  <div class="qf-grid">
    <div class="qf-field">
      <label for="qf-name">Name</label>
      <input id="qf-name" name="name" type="text" autocomplete="name" required aria-describedby="qf-name-err" />
      <p class="qf-err" id="qf-name-err" hidden>Please enter your name.</p>
    </div>
    <div class="qf-field">
      <label for="qf-phone">Phone</label>
      <input id="qf-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required aria-describedby="qf-phone-err" />
      <p class="qf-err" id="qf-phone-err" hidden>Enter a phone number with area code.</p>
    </div>
    <div class="qf-field">
      <label for="qf-service">Service needed</label>
      <select id="qf-service" name="service" required aria-describedby="qf-service-err">
        <option value="">Choose a service</option>
        {services.map((s) => <option value={s.data.title}>{s.data.title}</option>)}
        <option value="Not sure">Not sure, I need advice</option>
      </select>
      <p class="qf-err" id="qf-service-err" hidden>Please choose a service.</p>
    </div>
    <div class="qf-field">
      <label for="qf-zip">ZIP code</label>
      <input id="qf-zip" name="zip" type="text" inputmode="numeric" autocomplete="postal-code" required pattern="[0-9]{5}(-[0-9]{4})?" maxlength="10" aria-describedby="qf-zip-err" />
      <p class="qf-err" id="qf-zip-err" hidden>Enter a 5-digit US ZIP code.</p>
    </div>
  </div>
  <div class="qf-row">
    <fieldset class="qf-method">
      <legend>How should we reach you?</legend>
      <div class="seg">
        <input type="radio" id="qf-m-call" name="contact_method" value="Phone call" checked />
        <label for="qf-m-call"><Icon name="phone" size={18} /> Phone call</label>
        <input type="radio" id="qf-m-wa" name="contact_method" value="WhatsApp" />
        <label for="qf-m-wa">
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2.2a9.8 9.8 0 0 0-8.4 14.8L2.2 21.8l4.9-1.3A9.8 9.8 0 1 0 12 2.2Zm0 17.9a8.1 8.1 0 0 1-4.1-1.1l-.3-.2-2.9.8.8-2.8-.2-.3A8.1 8.1 0 1 1 12 20.1Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.6 6.6 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3Z"/></svg>
          WhatsApp
        </label>
      </div>
    </fieldset>
    <button class="btn btn-primary qf-btn" type="submit">Request my quote <Icon name="arrow" /></button>
  </div>
  <div class="hp" aria-hidden="true">
    <label for="qf-company">Leave this field empty</label>
    <input id="qf-company" name="company" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <p class="qf-note">
    {hasPhone() ? <span>Prefer to talk now? <a href={telHref()}>Call {site.phoneDisplay}</a>. </span> : null}
    By sending, you agree to our <a href="/privacy-policy/">privacy policy</a>.
  </p>
  <div class="status" role="status" aria-live="polite" tabindex="-1" data-status hidden></div>
</form>

<style>
  .qform {
    position: relative; display: grid; gap: 14px;
    background: var(--white); color: var(--ink);
    border: 1px solid var(--brass); border-top: 4px solid var(--brass-bright);
    border-radius: var(--radius-lg); padding: clamp(16px, 2.6vw, 24px);
    box-shadow: 0 24px 60px -24px rgba(0, 0, 0, 0.55), 0 0 0 6px rgba(201, 160, 78, 0.12);
  }
  .qf-head { display: grid; gap: 4px; }
  @media (min-width: 900px) { .qf-head { grid-template-columns: auto 1fr; align-items: baseline; gap: 18px; } }
  .qf-title { font-family: var(--font-display); font-weight: 800; font-size: var(--step-1); line-height: 1.15; color: var(--ink); }
  .qf-sub { font-size: 0.96rem; line-height: 1.45; color: var(--text-muted); }
  .qf-grid { display: grid; gap: 12px; grid-template-columns: 1fr; }
  @media (min-width: 560px) { .qf-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 900px) { .qf-grid { grid-template-columns: 1fr 1fr 1.3fr 0.8fr; } }
  .qf-field { display: grid; gap: 4px; align-content: start; }
  label, legend { font-family: var(--font-display); font-weight: 650; font-size: 0.86rem; color: var(--ink); }
  input[type='text'], input[type='tel'], select {
    width: 100%; min-height: 48px; padding: 10px 12px; font-size: 1rem; line-height: 1.3;
    border: 1.5px solid var(--steel-400); border-radius: var(--radius); background: #fff; color: var(--ink);
  }
  input:focus-visible, select:focus { border-color: var(--ink); outline: 3px solid var(--brass-bright); outline-offset: 1px; }
  [aria-invalid='true'] { border-color: var(--danger); }
  .qf-err { font-size: 0.84rem; font-weight: 600; color: var(--danger); }
  .qf-row { display: grid; gap: 14px; align-items: end; }
  @media (min-width: 900px) { .qf-row { grid-template-columns: auto 1fr; } }
  .qf-method { border: 0; padding: 0; margin: 0; min-width: 0; }
  .qf-method legend { padding: 0; margin-bottom: 6px; }
  .seg { display: grid; grid-template-columns: 1fr 1fr; border: 1.5px solid var(--steel-400); border-radius: var(--radius); overflow: hidden; background: #fff; }
  @media (min-width: 900px) { .seg { min-width: 330px; } }
  .seg input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .seg label {
    display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 48px; padding: 0 14px;
    cursor: pointer; font-size: 0.95rem; color: var(--text-muted); transition: background-color .15s ease, color .15s ease;
  }
  .seg label + input + label { border-left: 1.5px solid var(--steel-400); }
  .seg input:checked + label { background: var(--ink); color: var(--white); }
  .seg input#qf-m-wa:checked + label { background: #1f7a4d; color: #fff; }
  .seg input:focus-visible + label { outline: 3px solid var(--brass-bright); outline-offset: -3px; }
  .qf-btn { width: 100%; min-height: 52px; font-size: 1.06rem; }
  .qf-note { font-size: 0.84rem; color: var(--text-muted); line-height: 1.45; }
  .qf-note a { color: var(--brass-ink); }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .status { padding: 10px 12px; border-radius: var(--radius); font-size: 0.94rem; line-height: 1.45; }
  .status.success { background: #e6f1e7; color: var(--ok); border: 1px solid #b9d6bd; }
  .status.error { background: #f8e7e3; color: var(--danger); border: 1px solid #e6bdb3; }
  .status.info { background: var(--brass-soft); color: var(--ink); border: 1px solid #e0cc98; }
</style>
