---
/** Wordmark: cylinder face + extended bolt, set beside the name. */
interface Props { tone?: 'dark' | 'light' }
const { tone = 'light' } = Astro.props;
---
<span class:list={['logo', tone]}>
  <svg class="mark" viewBox="0 0 40 40" width="36" height="36" aria-hidden="true" focusable="false">
    <rect x="1" y="1" width="38" height="38" rx="7" fill="none" stroke="currentColor" stroke-width="2"></rect>
    <circle cx="16" cy="20" r="8.5" fill="none" stroke="#C9A04E" stroke-width="2.4"></circle>
    <rect x="14.6" y="15" width="2.8" height="8" rx="1.2" fill="#C9A04E"></rect>
    <rect x="24.5" y="17" width="12" height="6" rx="1" fill="currentColor"></rect>
  </svg>
  <span class="words">
    <span class="w1">Deadbolt Nation</span>
    <span class="w2">Locksmiths</span>
  </span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; line-height: 1; }
  .logo.light { color: var(--white); }
  .logo.dark { color: var(--ink); }
  .mark { flex: none; }
  .words { display: flex; flex-direction: column; gap: 3px; }
  .w1 { font-family: var(--font-display); font-weight: 800; font-size: 1.08rem; letter-spacing: -0.01em; }
  .w2 { font-family: var(--font-mono); font-size: 0.64rem; letter-spacing: 0.24em; text-transform: uppercase; color: var(--brass); }
  .dark .w2 { color: var(--brass-ink); }
</style>
