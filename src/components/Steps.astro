---
/** Numbered process styled like spec labels. Pass steps as {title, text}. */
interface Props { steps: { title: string; text: string }[]; label?: string }
const { steps, label } = Astro.props;
---
<ol class="steps" aria-label={label}>
  {steps.map((s, i) => (
    <li>
      <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
      <div>
        <p class="st">{s.title}</p>
        <p class="sx" set:html={s.text} />
      </div>
    </li>
  ))}
</ol>

<style>
  .steps { list-style: none; padding: 0 !important; display: grid; gap: 0; margin-block: 1.8em !important; counter-reset: none; }
  .steps li { display: grid; grid-template-columns: 52px 1fr; gap: 14px; position: relative; padding-bottom: 22px; margin: 0 !important; }
  .steps li:not(:last-child)::before { content: ''; position: absolute; left: 21px; top: 44px; bottom: 4px; width: 1px; background: repeating-linear-gradient(to bottom, var(--steel-400) 0 4px, transparent 4px 8px); }
  .num { width: 44px; height: 44px; border-radius: 50%; border: 1.5px solid var(--brass); display: grid; place-items: center; font-family: var(--font-mono); font-size: 0.82rem; color: var(--brass-ink); background: var(--white); }
  .st { font-family: var(--font-display); font-weight: 700; font-size: 1.06rem; line-height: 1.3; padding-top: 9px; }
  .sx { margin-top: 4px; }
</style>
