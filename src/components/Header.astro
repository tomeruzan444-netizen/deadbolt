---
import { getCollection } from 'astro:content';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site, hasPhone, telHref } from '../config/site';
import { serviceUrl } from '../lib/urls';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const path = Astro.url.pathname;
const serviceSlugs = new Set(services.map((s) => serviceUrl(s.id)));
const isServices = path === '/services/' || serviceSlugs.has(path);
const nav = [
  { label: 'Deadbolt Guides', href: '/deadbolt-guides/' },
  { label: 'Service Areas', href: '/service-areas/' },
  { label: 'About', href: '/about/' },
  { label: 'Contact', href: '/contact/' },
];
const current = (href: string) => (path === href || path.startsWith(href) ? 'page' : undefined);
---
<header class="site-header on-dark" data-header>
  <div class="container bar">
    <a href="/" class="brand">
      <Logo />
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" data-menu-toggle>
      <Icon name="menu" class="i-open" size={24} />
      <Icon name="close" class="i-close" size={24} />
      <span class="visually-hidden">Menu</span>
    </button>

    <nav id="primary-nav" class="nav" aria-label="Main">
      <ul class="nav-list">
        <li class="has-dd" data-dd>
          <div class="dd-head">
            <a href="/services/" aria-current={isServices ? 'page' : undefined}>Services</a>
            <button type="button" class="dd-btn" aria-expanded="false" aria-controls="dd-services" data-dd-btn>
              <Icon name="chevron" size={16} />
              <span class="visually-hidden">Show all deadbolt services</span>
            </button>
          </div>
          <div class="dd" id="dd-services">
            <ul class="dd-list">
              {services.map((s) => (
                <li>
                  <a href={serviceUrl(s.id)} aria-current={path === serviceUrl(s.id) ? 'page' : undefined}>
                    <Icon name={s.data.icon ?? 'install'} size={18} />
                    <span>{s.data.title}</span>
                  </a>
                </li>
              ))}
            </ul>
            <a class="dd-all" href="/services/">All deadbolt lock services <Icon name="arrow" size={16} /></a>
          </div>
        </li>
        {nav.map((n) => (
          <li><a href={n.href} aria-current={current(n.href)}>{n.label}</a></li>
        ))}
      </ul>
      {hasPhone() && (
        <a class="btn btn-primary call" href={telHref()}>
          <Icon name="phone" />
          <span>Call Now<span class="call-num"> {site.phoneDisplay}</span></span>
        </a>
      )}
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: rgba(20, 23, 28, 0.97);
    border-bottom: 1px solid rgba(201, 160, 78, 0.22);
    transition: box-shadow 0.2s ease;
  }
  @supports (backdrop-filter: blur(8px)) {
    .site-header { background: rgba(20, 23, 28, 0.9); backdrop-filter: blur(8px); }
  }
  .site-header.is-compact { box-shadow: 0 6px 20px -10px rgba(0, 0, 0, 0.6); }
  .bar { display: flex; align-items: center; justify-content: space-between; min-height: var(--header-h); gap: 16px; transition: min-height 0.2s ease; }
  .is-compact .bar { min-height: 56px; }
  .brand { text-decoration: none; display: inline-flex; padding-block: 6px; }

  .menu-toggle {
    display: none; background: transparent; border: 1px solid var(--steel-700); color: var(--white);
    width: 46px; height: 46px; border-radius: var(--radius); align-items: center; justify-content: center;
  }
  .menu-toggle :global(.i-close) { display: none; }
  .menu-toggle[aria-expanded='true'] :global(.i-open) { display: none; }
  .menu-toggle[aria-expanded='true'] :global(.i-close) { display: block; }

  .nav { display: flex; align-items: center; gap: 22px; }
  .nav-list { display: flex; align-items: center; gap: 4px; list-style: none; padding: 0; }
  .nav-list a {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 10px;
    font-family: var(--font-display); font-weight: 650; font-size: 0.95rem;
    color: #e9e5dc; text-decoration: none; border-radius: var(--radius);
  }
  .nav-list a:hover { color: var(--brass-bright); }
  .nav-list a[aria-current='page'] { color: var(--brass-bright); box-shadow: inset 0 -2px 0 var(--brass); border-radius: 0; }

  .has-dd { position: relative; }
  .dd-head { display: flex; align-items: center; }
  .dd-head a { padding-right: 2px; }
  .dd-btn {
    background: transparent; border: 0; color: #e9e5dc; width: 32px; height: 44px;
    display: inline-flex; align-items: center; justify-content: center; border-radius: var(--radius);
  }
  .dd-btn :global(svg) { transition: transform 0.15s ease; }
  .dd-btn[aria-expanded='true'] :global(svg) { transform: rotate(180deg); }
  .dd {
    display: none; position: absolute; top: calc(100% + 6px); left: -12px; width: min(620px, 90vw);
    background: var(--graphite); border: 1px solid rgba(201, 160, 78, 0.28); border-radius: var(--radius-lg);
    padding: 12px; box-shadow: 0 24px 48px -20px rgba(0, 0, 0, 0.7);
  }
  .has-dd.is-open .dd { display: block; }
  @media (hover: hover) and (min-width: 1025px) {
    .has-dd:hover .dd { display: block; }
    .has-dd::after { content: ''; position: absolute; left: 0; right: 0; top: 100%; height: 10px; }
  }
  .dd-list { list-style: none; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 2px; }
  .dd-list a { width: 100%; gap: 10px; font-size: 0.92rem; padding: 6px 10px; min-height: 42px; }
  .dd-list a:hover { background: var(--graphite-2); }
  .dd-list :global(svg) { color: var(--brass); flex: none; }
  .dd-all {
    display: flex; align-items: center; justify-content: space-between; margin-top: 8px; padding: 12px 10px 4px;
    border-top: 1px solid var(--graphite-2); font-family: var(--font-mono); font-size: 0.75rem;
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--brass-bright); text-decoration: none;
  }
  .call { min-height: 44px; padding-inline: 1em; }
  .call-num { display: none; }
  @media (min-width: 1200px) { .call-num { display: inline; } }

  /* Mobile */
  @media (max-width: 1024px) {
    :global(.js) .menu-toggle { display: inline-flex; }
    .nav {
      position: absolute; top: 100%; left: 0; right: 0; flex-direction: column; align-items: stretch; gap: 16px;
      background: var(--ink); border-bottom: 1px solid rgba(201, 160, 78, 0.22);
      padding: 12px var(--gutter) 24px; max-height: calc(100dvh - var(--header-h)); overflow-y: auto;
    }
    :global(.js) .nav { display: none; }
    :global(.js) .nav.is-open { display: flex; }
    :global(html:not(.js)) .site-header { position: static; }
    :global(html:not(.js)) .nav { position: static; padding-inline: 0; }
    .nav-list { flex-direction: column; align-items: stretch; gap: 0; }
    .nav-list > li { border-bottom: 1px solid var(--graphite-2); }
    .nav-list a { min-height: 52px; font-size: 1.05rem; padding-inline: 4px; }
    .dd-head { justify-content: space-between; }
    .dd-btn { width: 52px; height: 52px; }
    .dd { position: static; width: auto; border: 0; box-shadow: none; padding: 0 0 10px; background: transparent; }
    .dd-list { grid-template-columns: 1fr; }
    .dd-list a { min-height: 46px; font-size: 0.98rem; }
    .call { width: 100%; min-height: 52px; }
  }
</style>
