---
/**
 * Navigation list of published state pages (on the service areas hub) or of a state's
 * published city pages (on a state page). Built only from pages that pass the publishing
 * gate, so it grows on its own as pages go live. QA treats `.area-list` as navigation,
 * not as contextual links. Renders nothing when there is nothing published yet.
 */
import { builtStates, builtCities } from '../lib/areas';
import { areaUrl } from '../lib/urls';
interface Props { state?: string; headingLevel?: 'h3' | 'h2' }
const { state, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
const items = state ? await builtCities(state) : await builtStates();
const url = (a: (typeof items)[number]) => (state ? areaUrl(state, a.id.split('/')[1]) : areaUrl(a.id));
---
{items.length > 0 && (
  <ul class:list={['area-list', { cities: !!state }]}>
    {items.map((a) => (
      <li>
        <a href={url(a)} class="ar">
          <span class="code mono" aria-hidden="true">{a.data.place.stateCode}</span>
          <span class="txt">
            <H class="t">{a.data.place.name}</H>
            <p class="b">{a.data.cardBlurb}</p>
          </span>
        </a>
      </li>
    ))}
  </ul>
)}

<style>
  .area-list { list-style: none; padding: 0 !important; margin-block: 1.6em !important; display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); }
  .area-list li { margin: 0 !important; }
  .ar { height: 100%; display: flex; gap: 14px; align-items: flex-start; padding: 16px 18px; border-radius: var(--radius-lg); text-decoration: none; color: var(--ink); background: var(--white); border: 1px solid var(--line); transition: border-color .15s ease, box-shadow .15s ease; }
  .ar:hover, .ar:focus-visible { border-color: var(--brass); box-shadow: var(--shadow); color: var(--ink); }
  .code { flex: none; width: 42px; height: 42px; display: grid; place-items: center; border-radius: 50%; background: var(--brass-soft); color: var(--brass-ink); font-size: .8rem; font-weight: 700; letter-spacing: .06em; }
  .txt { display: flex; flex-direction: column; gap: 4px; }
  .t { font-family: var(--font-display); font-size: 1.05rem; font-weight: 700; line-height: 1.25; margin: 0 !important; }
  .t::before { display: none !important; }
  .ar:hover .t { text-decoration: underline; text-decoration-color: var(--brass); }
  .b { font-size: .92rem; line-height: 1.5; color: var(--text-muted); margin: 0 !important; }
</style>
