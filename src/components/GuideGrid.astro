---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import { guideUrl } from '../lib/urls';
interface Props { headingLevel?: 'h3' | 'h2'; limit?: number }
const { headingLevel = 'h3', limit } = Astro.props;
const H = headingLevel;
let guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
if (limit) guides = guides.slice(0, limit);
---
<ul class="g-grid">
  {guides.map((g) => (
    <li>
      <a href={guideUrl(g.id)} class="g">
        <span class="lbl"><Icon name="guide" size={16} /> Guide</span>
        <H class="t">{g.data.title}</H>
        <p class="b">{g.data.cardBlurb}</p>
      </a>
    </li>
  ))}
</ul>

<style>
  .g-grid { list-style: none; padding: 0 !important; display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); margin-block: 1.6em !important; }
  .g-grid li { margin: 0 !important; }
  .g { height: 100%; display: flex; flex-direction: column; gap: 8px; padding: 20px; border-radius: var(--radius-lg); text-decoration: none; background: var(--white); border: 1px solid var(--line); border-top: 3px solid var(--brass); color: var(--ink); transition: box-shadow .15s ease; }
  .g:hover { box-shadow: var(--shadow); color: var(--ink); }
  .g:hover .t { text-decoration: underline; text-decoration-color: var(--brass); }
  .lbl { display: inline-flex; gap: 6px; align-items: center; font-family: var(--font-mono); font-size: .72rem; letter-spacing: .1em; text-transform: uppercase; color: var(--brass-ink); }
  .t { font-family: var(--font-display); font-size: 1.14rem; font-weight: 700; line-height: 1.25; margin: 0 !important; }
  .t::before { display: none !important; }
  .b { font-size: .96rem; line-height: 1.55; color: var(--text-muted); margin: 0 !important; }
</style>
