---
/**
 * Exploded view of a single cylinder deadbolt, drawn to a consistent scale
 * (1 in = 42 px): 2-3/8 in backset, 1 in bolt throw, 2-1/8 in bore-sized housings.
 * tone="dark" for graphite/blueprint backgrounds, "light" for paper.
 */
interface Props { tone?: 'dark' | 'light'; id?: string; labelled?: boolean }
const { tone = 'dark', id = 'exploded', labelled = true } = Astro.props;
---
<svg class:list={['xp', tone]} viewBox="0 0 800 400" role="img" aria-labelledby={`${id}-t ${id}-d`}>
  <title id={`${id}-t`}>Exploded view of a single cylinder deadbolt</title>
  <desc id={`${id}-d`}>From left to right: the key, the exterior cylinder with its tailpiece, the bolt assembly with a 1 inch throw and a 2-3/8 inch backset, the interior mounting plate joined by two through-bolts, the interior thumb turn, and a reinforced strike plate with two 3 inch screws that reach the wall framing.</desc>

  <!-- center axis -->
  <path class="axis" d="M14 200H530" />

  <!-- 1. key -->
  <g class="part">
    <circle class="ln" cx="44" cy="200" r="20" />
    <circle class="ln" cx="38" cy="200" r="5" />
    <path class="ln" d="M64 193H84L88 187H96L100 193H104L108 185H116L120 193H126L130 189H138L142 193H152L160 201L152 209H64" />
    <path class="thin" d="M70 201H146" />
  </g>

  <!-- 2. exterior cylinder + tailpiece -->
  <g class="part">
    <rect class="ln" x="180" y="142" width="10" height="116" rx="3" />
    <path class="ln" d="M190 158H236Q246 158 246 168V232Q246 242 236 242H190" />
    <path class="thin" d="M190 186H238M190 214H238" />
    <rect class="ac" x="246" y="196" width="50" height="8" rx="1" />
  </g>

  <!-- through-bolts -->
  <path class="bolt" d="M246 176H422M246 224H422" />

  <!-- 3. bolt assembly (door edge is at the top) -->
  <g class="part">
    <rect class="ln fill" x="290" y="176" width="28" height="48" rx="4" />
    <rect class="ac" x="300" y="194" width="8" height="12" rx="1" />
    <rect class="ln" x="296" y="104" width="16" height="72" />
    <rect class="ln fill" x="282" y="96" width="44" height="8" rx="1" />
    <rect class="ac solid" x="297" y="54" width="14" height="42" rx="2" />
  </g>

  <!-- throw dimension -->
  <g class="dim">
    <path d="M336 54H350M336 96H350M343 58V92" />
    <path class="arr" d="M343 54l-3.5 7h7zM343 96l-3.5-7h7z" />
    <text x="356" y="72" class="t">1 IN</text>
    <text x="356" y="85" class="t sm">THROW</text>
  </g>
  <!-- backset dimension -->
  <g class="dim">
    <path d="M262 96H276M262 200H276M269 100V196" />
    <path class="arr" d="M269 96l-3.5 7h7zM269 200l-3.5-7h7z" />
    <text x="254" y="114" class="t" text-anchor="end">BACKSET</text>
    <text x="254" y="127" class="t sm" text-anchor="end">2-3/8 OR 2-3/4 IN</text>
  </g>

  <!-- 4. interior mounting plate -->
  <g class="part">
    <rect class="ln fill" x="370" y="150" width="8" height="100" rx="2" />
  </g>

  <!-- 5. thumb turn -->
  <g class="part">
    <rect class="ln" x="420" y="144" width="10" height="112" rx="3" />
    <path class="ln" d="M430 168H462Q470 168 470 176V224Q470 232 462 232H430" />
    <path class="ln fill" d="M470 172Q496 172 498 186V214Q496 228 470 228Z" />
  </g>

  <!-- 6. strike plate + 3 in screws -->
  <g class="part">
    <rect class="ln" x="580" y="130" width="50" height="140" rx="4" />
    <rect class="ac" x="592" y="176" width="26" height="48" rx="3" />
    <circle class="ln" cx="605" cy="148" r="5" />
    <circle class="ln" cx="605" cy="252" r="5" />
    <g class="screw">
      <rect x="656" y="141" width="8" height="14" rx="1" />
      <path d="M664 148H782M672 144l4 8M682 144l4 8M692 144l4 8M702 144l4 8M712 144l4 8M722 144l4 8M732 144l4 8M742 144l4 8M752 144l4 8M762 144l4 8M772 144l4 8" />
    </g>
    <g class="screw">
      <rect x="656" y="245" width="8" height="14" rx="1" />
      <path d="M664 252H782M672 248l4 8M682 248l4 8M692 248l4 8M702 248l4 8M712 248l4 8M722 248l4 8M732 248l4 8M742 248l4 8M752 248l4 8M762 248l4 8M772 248l4 8" />
    </g>
    <g class="dim">
      <path d="M664 190V206M782 190V206M668 198H778" />
      <path class="arr" d="M664 198l7-3.5v7zM782 198l-7-3.5v7z" />
      <text x="723" y="186" class="t" text-anchor="middle">3 IN</text>
      <text x="723" y="222" class="t sm" text-anchor="middle">INTO FRAMING</text>
    </g>
  </g>

  {labelled && (
    <g class="callouts">
      <path class="lead" d="M70 222V300M213 258V340M304 224V300M374 250V340M466 256V300M605 270V340" />
      <g><circle cx="70" cy="312" r="11" /><text x="70" y="316" class="n">1</text><text x="88" y="316" class="t">KEY</text></g>
      <g><circle cx="213" cy="352" r="11" /><text x="213" y="356" class="n">2</text><text x="231" y="356" class="t">CYLINDER</text></g>
      <g><circle cx="304" cy="312" r="11" /><text x="304" y="316" class="n">3</text><text x="322" y="316" class="t">BOLT</text></g>
      <g><circle cx="374" cy="352" r="11" /><text x="374" y="356" class="n">4</text><text x="392" y="356" class="t">MOUNTING PLATE</text></g>
      <g><circle cx="466" cy="312" r="11" /><text x="466" y="316" class="n">5</text><text x="484" y="316" class="t">THUMB TURN</text></g>
      <g><circle cx="605" cy="352" r="11" /><text x="605" y="356" class="n">6</text><text x="623" y="356" class="t">STRIKE + SCREWS</text></g>
    </g>
  )}
</svg>

<style>
  .xp { width: 100%; height: auto; overflow: visible; }
  .xp { --c: #e9e5dc; --a: #c9a04e; --f: rgba(201, 160, 78, 0.08); --d: #8c949f; }
  .xp.light { --c: #14171c; --a: #7a5a1c; --f: rgba(122, 90, 28, 0.08); --d: #4a525e; }
  .ln, .thin, .ac, .bolt, .axis, .dim path, .lead, .screw * { fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .ln { stroke: var(--c); stroke-width: 1.6; }
  .ln.fill { fill: var(--f); }
  .thin { stroke: var(--c); stroke-width: 0.9; opacity: 0.55; }
  .ac { stroke: var(--a); stroke-width: 1.8; }
  .ac.solid { fill: var(--a); fill-opacity: 0.25; }
  .axis { stroke: var(--d); stroke-width: 0.9; stroke-dasharray: 10 4 2 4; }
  .bolt { stroke: var(--d); stroke-width: 1.1; stroke-dasharray: 5 4; }
  .dim path { stroke: var(--a); stroke-width: 1; }
  .dim .arr { fill: var(--a); stroke: none; }
  .screw rect, .screw path { stroke: var(--c); stroke-width: 1.3; }
  .lead { stroke: var(--d); stroke-width: 0.9; stroke-dasharray: 2 3; }
  .callouts circle { fill: none; stroke: var(--a); stroke-width: 1.3; }
  .t { font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.08em; fill: var(--c); }
  .t.sm { font-size: 9.5px; fill: var(--d); }
  .dark .t.sm { fill: #b9b3a6; }
  .n { font-family: var(--font-mono); font-size: 11px; fill: var(--a); text-anchor: middle; }
</style>
