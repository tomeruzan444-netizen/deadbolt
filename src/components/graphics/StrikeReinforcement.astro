---
/**
 * Top-down section through a door jamb, comparing short strike screws that stop in
 * the jamb with 3 in screws that pass through the jamb and shim gap into the framing.
 * Scale: 1 in = 40 px. Jamb 3/4 in, shim gap ~3/8 in, two 1-1/2 in studs.
 */
const S = 40;
const jamb = 0.75 * S, gap = 0.375 * S, stud = 1.5 * S;
type P = { title: string; screw: number; ok: boolean; note: string };
const panels: P[] = [
  { title: 'TYPICAL: SHORT SCREWS', screw: 0.75 * S, ok: false, note: 'SCREWS END IN THE JAMB' },
  { title: 'REINFORCED: 3 IN SCREWS', screw: 3 * S, ok: true, note: 'SCREWS BITE INTO FRAMING' },
];
const screwPath = (x0: number, len: number, y: number) => {
  let d = `M${x0} ${y - 6}h5v12h-5z M${x0 + 5} ${y}H${x0 + len}`;
  for (let x = x0 + 10; x < x0 + len - 4; x += 8) d += ` M${x} ${y - 3.5}l3 7`;
  return d;
};
---
<svg class="sr" viewBox="0 0 720 300" role="img" aria-labelledby="sr-t sr-d">
  <title id="sr-t">Deadbolt strike plate reinforcement with 3 inch screws</title>
  <desc id="sr-d">Two top-down sections through a door jamb. On the left, the strike plate is held by short screws that stop inside the thin wood jamb, so a kick splits the jamb. On the right, 3 inch screws pass through the jamb and the shim gap and anchor in the wall studs behind it, so the force goes into the framing.</desc>
  {panels.map((p, i) => {
    const ox = i * 360 + 20;
    const x0 = ox + 70;
    return (
      <g>
        <text x={ox} y="28" class="t">{`0${i + 1}  ${p.title}`}</text>
        <!-- door + bolt -->
        <rect class="doorslab" x={ox} y="70" width="62" height="140" rx="2" />
        <rect class="boltpart" x={ox + 40} y="128" width={x0 + 18 - (ox + 40)} height="24" rx="2" />
        <text x={ox + 4} y="232" class="t sm">DOOR</text>
        <!-- strike + jamb + gap + studs -->
        <rect class="strike" x={x0 - 4} y="96" width="6" height="88" />
        <rect class="jamb" x={x0 + 2} y="80" width={jamb} height="120" />
        <rect class="gap" x={x0 + 2 + jamb} y="80" width={gap} height="120" />
        <rect class="stud" x={x0 + 2 + jamb + gap} y="60" width={stud} height="160" />
        <rect class="stud" x={x0 + 2 + jamb + gap + stud} y="60" width={stud} height="160" />
        <path class="grain" d={`M${x0 + 8 + jamb + gap} 76 q20 30 0 60 q-20 30 0 64 M${x0 + 30 + jamb + gap} 70 q14 40 0 80 q-14 30 0 64 M${x0 + 8 + jamb + gap + stud} 76 q20 30 0 60 q-20 30 0 64 M${x0 + 30 + jamb + gap + stud} 70 q14 40 0 80 q-14 30 0 64`} />
        <path class:list={['screw', p.ok ? 'good' : 'weak']} d={screwPath(x0 - 4, p.screw, 108)} />
        <path class:list={['screw', p.ok ? 'good' : 'weak']} d={screwPath(x0 - 4, p.screw, 172)} />
        {!p.ok && <path class="crack" d={`M${x0 + 6} 140 l6 -10 l-4 -8 l8 -12 M${x0 + 10} 150 l5 9 l-3 8`} />}
        <text x={x0 + 2} y="232" class="t sm">JAMB</text>
        <text x={x0 + 2 + jamb + gap + 4} y="244" class="t sm">STUDS (FRAMING)</text>
        <text x={ox} y="276" class:list={['t', p.ok ? 'ok' : 'no']}>{p.note}</text>
      </g>
    );
  })}
</svg>

<style>
  .sr { width: 100%; height: auto; }
  .doorslab { fill: #fffdf8; stroke: #14171c; stroke-width: 1.3; }
  .boltpart { fill: rgba(122, 90, 28, 0.25); stroke: #7a5a1c; stroke-width: 1.3; }
  .strike { fill: #8c949f; stroke: #4a525e; stroke-width: 1; }
  .jamb { fill: #efe2c6; stroke: #7a5a1c; stroke-width: 1.1; }
  .gap { fill: #fffdf8; stroke: #cfc8b8; stroke-width: 0.8; stroke-dasharray: 3 3; }
  .stud { fill: #e4d3ad; stroke: #7a5a1c; stroke-width: 1.1; }
  .grain { fill: none; stroke: rgba(122, 90, 28, 0.35); stroke-width: 0.8; }
  .screw { fill: none; stroke-width: 1.5; stroke-linecap: round; }
  .screw.good { stroke: #14171c; }
  .screw.weak { stroke: #a3361f; }
  .crack { fill: none; stroke: #a3361f; stroke-width: 1.4; stroke-linejoin: round; }
  .t { font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.08em; fill: #14171c; }
  .t.sm { font-size: 10px; fill: #4a525e; }
  .ok { fill: #2f6b3a; }
  .no { fill: #a3361f; }
</style>
