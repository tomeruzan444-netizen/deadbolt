---
/**
 * How rekeying works: three pin-tumbler cross-sections.
 * 1) original key + original key pins: all gaps line up at the shear line (turns)
 * 2) new key pins + new key: line up again (turns)
 * 3) old key in the rekeyed cylinder: pins cross the shear line (blocked)
 * Geometry is computed so the diagram is always internally correct.
 */
const SHEAR = 140, TOP = 26, PLUG_BOTTOM = 222, DRIVER = 38;
const xs = [36, 76, 116, 156, 196];
const oldPins = [30, 50, 22, 44, 36];
const newPins = [44, 26, 38, 20, 50];

type Panel = { title: string; status: string; ok: boolean; pins: number[]; keyCuts: number[] };
const panels: Panel[] = [
  { title: 'ORIGINAL KEY', status: 'TURNS', ok: true, pins: oldPins, keyCuts: oldPins },
  { title: 'NEW PINS + NEW KEY', status: 'TURNS', ok: true, pins: newPins, keyCuts: newPins },
  { title: 'OLD KEY AFTER REKEY', status: 'BLOCKED', ok: false, pins: newPins, keyCuts: oldPins },
];

const keyPath = (cuts: number[]) => {
  let d = `M8 ${PLUG_BOTTOM - 14} V${SHEAR + 16} `;
  xs.forEach((x, i) => {
    const y = SHEAR + cuts[i];
    d += `L${x - 12} ${SHEAR + 16} L${x - 4} ${y} H${x + 4} L${x + 12} ${SHEAR + 16} `;
  });
  d += `L222 ${SHEAR + 16} V${PLUG_BOTTOM - 14} Z`;
  return d;
};
const spring = (x: number, y1: number, y2: number) => {
  const n = 6, step = (y2 - y1) / n;
  let d = `M${x} ${y1}`;
  for (let i = 1; i <= n; i++) d += ` L${x + (i % 2 ? 5 : -5)} ${y1 + step * i - step / 2} L${x} ${y1 + step * i}`;
  return d;
};
---
<svg class="rk" viewBox="0 0 720 300" role="img" aria-labelledby="rk-t rk-d">
  <title id="rk-t">How deadbolt rekeying works</title>
  <desc id="rk-d">Three cross-sections of a pin tumbler cylinder. Left: the original key lifts each key pin so every gap sits on the shear line and the plug turns. Middle: after rekeying, new key pins of different lengths match a new key, and the gaps line up again. Right: the old key in the rekeyed cylinder leaves pins crossing the shear line, so the plug cannot turn.</desc>
  {panels.map((p, pi) => (
    <g transform={`translate(${pi * 240 + 6} 20)`}>
      <text x="0" y="0" class="t">{`0${pi + 1}  ${p.title}`}</text>
      <rect class="housing" x="0" y={TOP} width="228" height={PLUG_BOTTOM - TOP} rx="6" />
      <rect class="plug" x="4" y={SHEAR} width="220" height={PLUG_BOTTOM - SHEAR - 4} rx="3" />
      {xs.map((x, i) => {
        const keySurface = SHEAR + p.keyCuts[i];
        const pinTop = keySurface - p.pins[i];
        const driverTop = pinTop - DRIVER;
        const crosses = pinTop !== SHEAR;
        return (
          <g>
            <rect class="chamber" x={x - 9} y={TOP + 4} width="18" height={Math.min(SHEAR - TOP + p.pins[i] + 40, PLUG_BOTTOM - TOP - 12)} />
            <path class="spring" d={spring(x, TOP + 6, driverTop)} />
            <rect class="driver" x={x - 7} y={driverTop} width="14" height={DRIVER} rx="2" />
            <path class="keypin" d={`M${x - 7} ${pinTop + 2} q0 -2 2 -2 h10 q2 0 2 2 V${keySurface - 6} L${x} ${keySurface} L${x - 7} ${keySurface - 6} Z`} />
            {crosses && !p.ok && <circle class="x" cx={x} cy={SHEAR} r="10" />}
          </g>
        );
      })}
      <path class="shear" d={`M-4 ${SHEAR}H232`} />
      <path class="key" d={keyPath(p.keyCuts)} />
      <text x="0" y={PLUG_BOTTOM + 26} class="t sm">SHEAR LINE</text>
      <text x="228" y={PLUG_BOTTOM + 26} class:list={['t', 'st', p.ok ? 'ok' : 'no']} text-anchor="end">{p.status}</text>
    </g>
  ))}
</svg>

<style>
  .rk { width: 100%; height: auto; }
  .housing { fill: #fffdf8; stroke: #14171c; stroke-width: 1.4; }
  .plug { fill: #ece7dc; stroke: #4a525e; stroke-width: 1; }
  .chamber { fill: #f5f2eb; stroke: #cfc8b8; stroke-width: 0.8; }
  .spring { fill: none; stroke: #6b7380; stroke-width: 1.1; stroke-linejoin: round; }
  .driver { fill: #8c949f; stroke: #4a525e; stroke-width: 1; }
  .keypin { fill: #d9b45f; stroke: #7a5a1c; stroke-width: 1; }
  .key { fill: rgba(20, 23, 28, 0.12); stroke: #14171c; stroke-width: 1.3; stroke-linejoin: round; }
  .shear { stroke: #7a5a1c; stroke-width: 1.4; stroke-dasharray: 6 4; }
  .x { fill: none; stroke: #a3361f; stroke-width: 1.8; }
  .t { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; fill: #14171c; }
  .t.sm { fill: #7a5a1c; font-size: 10px; }
  .st { font-size: 12px; }
  .ok { fill: #2f6b3a; }
  .no { fill: #a3361f; }
</style>
