---
/** Horizontal (desktop) / vertical (mobile) process infographic built in HTML, so it is readable text. */
interface Props { steps: { title: string; text: string }[]; label: string; tone?: 'light' | 'dark' }
const { steps, label, tone = 'light' } = Astro.props;
---
<ol class:list={['proc', tone]} aria-label={label}>
  {steps.map((s, i) => (
    <li>
      <div class="node" aria-hidden="true"><span>{String(i + 1).padStart(2, '0')}</span></div>
      <p class="pt">{s.title}</p>
      <p class="px" set:html={s.text} />
    </li>
  ))}
</ol>

<style>
  .proc { list-style: none; padding: 0 !important; display: grid; gap: 0; margin-block: 2em !important; max-width: none; }
  .proc li { position: relative; display: grid; grid-template-columns: 56px 1fr; column-gap: 14px; padding-bottom: 24px; margin: 0 !important; }
  .proc li:not(:last-child)::before { content: ''; position: absolute; left: 27px; top: 56px; bottom: 0; width: 1px; background: repeating-linear-gradient(to bottom, var(--steel-400) 0 5px, transparent 5px 9px); }
  .node { width: 56px; height: 56px; border-radius: 50%; border: 1.5px solid var(--brass); display: grid; place-items: center; grid-row: span 2; background: var(--white); position: relative; }
  .node::after { content: ''; position: absolute; inset: 5px; border-radius: 50%; border: 1px dashed rgba(122,90,28,0.35); }
  .node span { font-family: var(--font-mono); font-size: 0.86rem; color: var(--brass-ink); }
  .pt { font-family: var(--font-display); font-weight: 700; font-size: 1.08rem; line-height: 1.3; padding-top: 6px; margin: 0 !important; }
  .px { font-size: 0.96rem; line-height: 1.55; color: var(--text-muted); margin: 6px 0 0 !important; }
  @media (min-width: 900px) {
    .proc { grid-template-columns: repeat(var(--n, 5), 1fr); gap: 20px; }
    .proc { --n: 5; }
    .proc li { grid-template-columns: 1fr; padding-bottom: 0; }
    .proc li:not(:last-child)::before { left: 64px; right: -14px; top: 28px; bottom: auto; width: auto; height: 1px; background: repeating-linear-gradient(to right, var(--steel-400) 0 5px, transparent 5px 9px); }
    .node { grid-row: auto; margin-bottom: 14px; }
    .pt { padding-top: 0; }
  }
  .proc:has(li:nth-child(4):last-child) { --n: 4; }
  .proc:has(li:nth-child(6)) { --n: 6; }
  .dark .node { background: var(--ink); }
  .dark .node span { color: var(--brass); }
  .dark .pt { color: var(--white); }
  .dark .px { color: #c9c4b8; }
</style>
