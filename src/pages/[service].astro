---
import { getCollection, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import { serviceCrumbs, serviceUrl } from '../lib/urls';
import { service } from '../lib/schema';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((entry) => ({ params: { service: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);
const crumbs = serviceCrumbs(d.title, entry.id);
---
<PageLayout
  title={d.metaTitle}
  description={d.metaDescription}
  crumbs={crumbs}
  h1={d.h1}
  eyebrow="Deadbolt service"
  intro={d.intro}
  keyFacts={d.keyFacts}
  updated={d.updated}
  published={d.published}
  showUpdated
  headings={headings}
  toc={d.toc}
  faqs={d.faqs}
  relatedKey={entry.id}
  schema={[service({ url: serviceUrl(entry.id), name: d.title, description: d.metaDescription })]}
>
  <Content />
</PageLayout>
