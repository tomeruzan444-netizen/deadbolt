---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import GuideGrid from '../components/GuideGrid.astro';
import QuickForm from '../components/QuickForm.astro';
---
<BaseLayout title="Page Not Found | Deadbolt Fixers" description="The page you were looking for is not here. Find deadbolt installation, repair, lockout and rekeying services or our deadbolt guides instead." noindex>
  <section class="nf on-dark blueprint">
    <div class="container nf-grid">
      <div>
      <p class="label code">Error 404 · Bolt not engaged</p>
      <h1>This page is not on our key ring</h1>
      <div class="nf-form"><QuickForm heading="Tell us what you need" /></div>
      <p class="lead-404">The link may be old or mistyped. Every deadbolt service and guide we publish is listed below, so the page you need is probably one click away.</p>
      <div class="acts">
        <a class="btn btn-primary" href="/">Go to the home page</a>
        <a class="btn btn-ghost" href="/contact/">Contact us</a>
      </div>
      </div>
    </div>
  </section>
  <div class="container nf-body">
    <h2>Deadbolt services</h2>
    <ServiceGrid />
    <h2>Deadbolt guides</h2>
    <GuideGrid />
  </div>
</BaseLayout>
<style>
  .nf { padding-block: 56px; }
  .nf-grid { display: grid; gap: 32px; align-items: start; }
  .nf-form { margin-top: 24px; max-width: 1100px; }
  .code { color: var(--brass); }
  h1 { margin-top: 12px; max-width: 26ch; }
  .lead-404 { margin-top: 16px; max-width: 56ch; color: #d6d1c6; font-size: var(--step-1); }
  .acts { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .nf-body { padding-block: 56px 80px; }
  .nf-body h2 { margin-top: 32px; font-size: var(--step-2); }
</style>
