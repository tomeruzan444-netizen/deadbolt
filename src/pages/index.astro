---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import QuickForm from '../components/QuickForm.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import Icon from '../components/Icon.astro';
import { site, hasPhone, telHref } from '../config/site';
import { webPage, faqPage } from '../lib/schema';

const entry = await getEntry('pages', 'home');
if (!entry) throw new Error('Missing src/content/pages/home.mdx');
const d = entry.data;
const { Content } = await render(entry);
const schema = [webPage({ url: '/', name: d.metaTitle, description: d.metaDescription, dateModified: d.updated }), faqPage('/', d.faqs)];
---
<BaseLayout title={d.metaTitle} description={d.metaDescription} schema={schema}>
  <section class="hero on-dark blueprint">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="label eyebrow">Deadbolt locks only · Nationwide, USA</p>
        <h1>{d.h1}</h1>
        <div class="hero-form">
          <QuickForm heading="Get a deadbolt quote" />
        </div>
        <p class="hero-lead" data-intro set:html={d.intro} />
        <div class="hero-cta">
          {hasPhone() && <a class="btn btn-primary" href={telHref()}><Icon name="phone" /> Call {site.phoneDisplay}</a>}
          <a class="btn btn-ghost" href="/services/">See all 12 deadbolt services <Icon name="arrow" /></a>
        </div>
        {d.keyFacts && (
          <ul class="spec">
            {d.keyFacts.map((f) => <li set:html={f} />)}
          </ul>
        )}
      </div>
    </div>
  </section>

  <div class="home-body" data-body>
    <Content />
  </div>

  <div class="container home-end">
    <Faq faqs={d.faqs} title="Deadbolt locksmith FAQ" />
    <Cta heading="Have a deadbolt problem right now?" text="Tell us what the lock is doing, or not doing. We will explain the likely cause and what a visit would involve before anything is scheduled." />
  </div>
</BaseLayout>

<style>
  .hero { padding-block: clamp(40px, 7vw, 88px) clamp(48px, 7vw, 96px); border-bottom: 1px solid rgba(201,160,78,.2); overflow: hidden; }
  .hero-grid { display: grid; gap: 40px; align-items: center; }
  .hero-form { margin-top: 28px; max-width: 1100px; }
  .eyebrow { color: var(--brass); display: inline-flex; align-items: center; gap: 10px; }
  .eyebrow::before { content: ''; width: 28px; height: 1px; background: currentColor; }
  .hero h1 { margin-top: 16px; max-width: 26ch; font-size: clamp(2rem, 1.4rem + 2.6vw, 3.4rem); }
  .hero-lead { margin-top: 28px; font-size: var(--step-1); line-height: 1.55; color: #d9d4c9; max-width: 54ch; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .spec { list-style: none; padding: 0; margin-top: 32px; display: grid; gap: 10px; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); border-top: 1px solid var(--graphite-2); padding-top: 20px; }
  .spec li { font-family: var(--font-mono); font-size: .76rem; letter-spacing: .06em; text-transform: uppercase; color: #b9b3a6; line-height: 1.45; }
  .spec :global(strong) { display: block; font-family: var(--font-display); font-size: 1.35rem; letter-spacing: 0; text-transform: none; color: var(--brass-bright); font-weight: 750; margin-bottom: 2px; }
  .home-end { padding-bottom: 80px; }
  .home-end :global(.faq), .home-end :global(.cta) { margin-inline: auto; }
  .home-end :global(.faq) { max-width: 820px; }
  .home-end :global(.cta) { max-width: 820px; }
</style>
