---
/**
 * Future city pages: add src/content/areas/{state}/{city}.mdx and this route
 * generates /service-areas/{state}/{city}/. Renders nothing until such files exist.
 * Add the page's slug ("{state}/{city}") to src/data/related.ts as well.
 */
import { getCollection, render } from 'astro:content';
import PageLayout from '../../../layouts/PageLayout.astro';
import { HOME, AREAS_HUB, areaUrl } from '../../../lib/urls';
import { service } from '../../../lib/schema';

export async function getStaticPaths() {
  const areas = await getCollection('areas');
  return areas
    .filter((a) => a.id.includes('/'))
    .map((entry) => {
      const [state, city] = entry.id.split('/');
      return { params: { state, city }, props: { entry } };
    });
}

const { entry } = Astro.props;
const [state, city] = entry.id.split('/');
const d = entry.data;
const { Content, headings } = await render(entry);
const stateName = state.replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase());
const crumbs = [HOME, AREAS_HUB, { name: stateName, url: areaUrl(state) }, { name: d.title, url: areaUrl(state, city) }];
---
<PageLayout
  title={d.metaTitle}
  description={d.metaDescription}
  crumbs={crumbs}
  h1={d.h1}
  eyebrow="Service area"
  intro={d.intro}
  keyFacts={d.keyFacts}
  updated={d.updated}
  showUpdated
  headings={headings}
  toc={d.toc}
  faqs={d.faqs}
  relatedKey={entry.id}
  schema={[service({ url: areaUrl(state, city), name: d.title, description: d.metaDescription, areaServed: { '@type': 'City', name: d.title } })]}
>
  <Content />
</PageLayout>
