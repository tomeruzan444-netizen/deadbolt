---
/**
 * State pages: src/content/areas/{state}.mdx -> /service-areas/{state}/.
 * Only pages that pass the publishing gate (src/lib/area-gate.mjs) are generated.
 * Published city pages of the state are listed automatically under the body.
 */
import { render } from 'astro:content';
import PageLayout from '../../../layouts/PageLayout.astro';
import AreaList from '../../../components/AreaList.astro';
import { HOME, AREAS_HUB, areaUrl } from '../../../lib/urls';
import { service } from '../../../lib/schema';
import { builtStates, builtCities, areaNoindex } from '../../../lib/areas';

export async function getStaticPaths() {
  return (await builtStates()).map((entry) => ({ params: { state: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);
const url = areaUrl(entry.id);
const crumbs = [HOME, AREAS_HUB, { name: d.place.name, url }];
const cities = await builtCities(entry.id);
---
<PageLayout
  title={d.metaTitle}
  description={d.metaDescription}
  crumbs={crumbs}
  h1={d.h1}
  eyebrow={`Service area · ${d.place.stateCode}`}
  intro={d.intro}
  keyFacts={d.keyFacts}
  updated={d.updated}
  published={d.published}
  showUpdated
  headings={headings}
  toc={d.toc}
  faqs={d.faqs}
  sources={d.sources}
  showSources
  relatedKey={d.relatedKey ?? 'area-page'}
  noindex={areaNoindex(entry)}
  schema={[service({ url, name: d.h1, description: d.metaDescription, areaServed: { '@type': 'State', name: d.place.stateName, address: { '@type': 'PostalAddress', addressRegion: d.place.stateCode, addressCountry: 'US' } } })]}
>
  <Content />
  {cities.length > 0 && (
    <>
      <h2 id="cities">Cities with a local page in {d.place.name}</h2>
      <AreaList state={entry.id} />
    </>
  )}
</PageLayout>
